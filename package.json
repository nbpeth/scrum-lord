  "scripts": {
    "start": "yarn --cwd ./api start",
    "start:api:local": "yarn --cwd ./api startlocal",
    "start:rs": "REACT_APP_API_KEY='key123' REACT_APP_SERVER_PORT=8080 react-app-rewired start",
    "start:ui:ci": "BROWSER=none REACT_APP_API_KEY='key123' REACT_APP_SERVER_PORT=8080 react-app-rewired start",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "build": "yarn && react-app-rewired build && yarn --cwd ./api install",
    "heroku-postbuild": "yarn build",
    "test": "react-app-rewired test",
    "eject": "react-app-rewired eject",
    "watch": "npm-watch"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "watch": {
    "build": {
      "patterns": [
        "src"
      ],
      "extensions": "js,jsx"
    }
  },
  "resolutions": {
    "@tsparticles/engine": "3.9.1"
  },
  "devDependencies": {
    "cypress": "^15.19.0",
    "wait-on": "^9.0.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
